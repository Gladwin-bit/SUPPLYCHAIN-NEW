{
  "expo": {
    "name": "Thread Proof",
    "slug": "thread-proof",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "threadproof",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.threadproof.app"
    },
    "android": {
      "package": "com.threadproof.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "threadproof"
            },
            {
              "scheme": "wc"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Thread Proof to scan QR codes for product verification."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Thread Proof to access your location for product verification records."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Thread Proof to access your photos to scan QR codes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "041e4da8-ba1b-4fe6-8fc1-08beab517f1e"
      }
    },
    "owner": "gladyyyy"
  }
}
