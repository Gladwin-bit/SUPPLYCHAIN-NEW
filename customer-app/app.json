{
  "expo": {
    "name": "Kasaragod Sarees",
    "slug": "kasaragod-saree-verify",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kasaragodsarees.verify"
    },
    "android": {
      "package": "com.kasaragodsarees.verify",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kasaragod Sarees to scan QR codes for product verification."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Kasaragod Sarees to access your location for product verification records."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kasaragod Sarees to access your photos to scan QR codes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
