PORT=5000
# Local Mongo (optional)
MONGODB_URI=mongodb://localhost:27017/supplychain
# Atlas/Cloud Mongo (recommended for shared auth data)
MONGODB_ATLAS_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# If true, backend will refuse localhost DB and require cloud URI
FORCE_CLOUD_DB=false
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
UPLOAD_PATH=./uploads
NODE_ENV=development
